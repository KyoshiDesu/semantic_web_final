                        </rdf:Description>
                      </rdf:rest>
                    </rdf:Description>
                  </rdf:rest>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#contradicts"/>
          <swrl:argument1 rdf:resource="urn:swrl#t"/>
          <swrl:argument2 rdf:resource="urn:swrl#r"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
</swrl:Imp>

<swrl:Imp>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#StudentTriple"/>
          <swrl:argument1 rdf:resource="urn:swrl#t"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:ClassAtom>
              <swrl:classPredicate rdf:resource="#ReferenceTriple"/>
              <swrl:argument1 rdf:resource="urn:swrl#r"/>
            </swrl:ClassAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:IndividualPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="#hasPredicate"/>
                  <swrl:argument1 rdf:resource="urn:swrl#t"/>
                  <swrl:argument2 rdf:resource="urn:swrl#pt"/>
                </swrl:IndividualPropertyAtom>
              </rdf:first>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first>
                    <swrl:IndividualPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="#hasPredicate"/>
                      <swrl:argument1 rdf:resource="urn:swrl#r"/>
                      <swrl:argument2 rdf:resource="urn:swrl#pr"/>
                    </swrl:IndividualPropertyAtom>
                  </rdf:first>
                  <rdf:rest>
                    <rdf:Description>
                      <rdf:first>
                        <swrl:IndividualPropertyAtom>
                          <swrl:propertyPredicate rdf:resource="#incompatibleWith"/>
                          <swrl:argument1 rdf:resource="urn:swrl#pt"/>
                          <swrl:argument2 rdf:resource="urn:swrl#pr"/>
                        </swrl:IndividualPropertyAtom>
                      </rdf:first>
                      <rdf:rest>
                        <rdf:Description>
                          <rdf:first>
                            <swrl:DatavaluedPropertyAtom>
                              <swrl:propertyPredicate rdf:resource="#negated"/>
                              <swrl:argument1 rdf:resource="urn:swrl#t"/>
                              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</swrl:argument2>
                            </swrl:DatavaluedPropertyAtom>
                          </rdf:first>
                          <rdf:rest>
                            <rdf:Description>
                              <rdf:first>
                                <swrl:IndividualPropertyAtom>
                                  <swrl:propertyPredicate rdf:resource="#alignedSubject"/>
                                  <swrl:argument1 rdf:resource="urn:swrl#t"/>
                                  <swrl:argument2 rdf:resource="urn:swrl#r"/>
                                </swrl:IndividualPropertyAtom>
                              </rdf:first>
                              <rdf:rest>
