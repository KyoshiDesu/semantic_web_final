@prefix ag: <http://example.org/autograde/ontology#> .
@prefix key: <http://example.org/autograde/key/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

key:SAF_STREE_R1 a ag:ReferenceTriple ;
    ag:criterion key:SAF_STREE_K1_Property ;
    ag:hasObject key:Loops ;
    ag:hasPredicate ag:lacks ;
    ag:hasSubject key:SpanningTree ;
    ag:weight 1.0 .

key:SAF_STREE_R2 a ag:ReferenceTriple ;
    ag:criterion key:SAF_STREE_K1_Property ;
    ag:hasObject key:DuplicatePackets ;
    ag:hasPredicate ag:prevents ;
    ag:hasSubject key:SpanningTree ;
    ag:weight 1.0 .

key:SAF_STREE_R3 a ag:ReferenceTriple ;
    ag:criterion key:SAF_STREE_K2_LinkState ;
    ag:hasObject key:MulticastGroupInfo ;
    ag:hasPredicate ag:has ;
    ag:hasSubject key:LinkStatePacket ;
    ag:weight 1.0 .

key:DuplicatePackets a ag:Concept,
        skos:Concept .

key:LinkStatePacket a ag:Concept,
        skos:Concept .

key:Loops a ag:Concept,
        skos:Concept .

key:MulticastGroupInfo a ag:Concept,
        skos:Concept .

key:SAF_STREE_K2_LinkState a ag:Criterion ;
    rdfs:comment "Link state packets carry multicast group information"@en .

key:SAF_STREE_K1_Property a ag:Criterion ;
    rdfs:comment "No loops"@en .

key:SpanningTree a ag:Concept,
        skos:Concept .

