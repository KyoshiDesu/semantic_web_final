# Copy to .env. Never commit .env.
# Key for llm.provider in config/config.yaml: OpenRouter by default (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Only for llm.provider: gemini (https://aistudio.google.com/apikey). The free tier may use prompts to improve Google's products: demo data only.
GEMINI_API_KEY=
# Only for llm.provider: anthropic
ANTHROPIC_API_KEY=
# Optional: path to a Java 25+ binary for Pellet (auto-detected otherwise)
JAVA_EXE=
